
// ==============================================
// HTTP server complex example
// Open an HTTP server on localhost that responds with simple HTML page
// ==============================================

#include "std"
#include "std/os/network"
#include "http"

const PORT = 8080;
const HOST = "127.0.0.1";

var server *HTTPServer;

func void handle_request[*HTTPRequest request]
    request.socket HTTP_STATUS_TEXT_OK
    "<h1>Hello from Gofra HTTP server!</h1><i>Built with Gofra and native HTTP library</i>";
    call http_send_html_response drop
end

func void main[]
    &server call http_server_new !<

    server
    pointer_of_proc handle_request
    HOST PORT
    call http_server_start
end