
// ==============================================
// HTTP server complex example
// Open an HTTP server on localhost that responds with simple HTML page
// ==============================================

#include "std"
#include "std/os/network"
#include "http"

const PORT = 8080;
const BACKLOG = 5;
const HOST = "127.0.0.1"

var server HTTPServer;
var html = "<h1>Hello from Gofra HTTP server!</h1><i>Built with Gofra and native HTTP library</i>";

func void handle_request[*HTTPIncomingRequest request]
    "sent bytez" print
    request html
    call http_server_send_html_response drop
end

func void main[]
    &server PORT BACKLOG HOST
    call http_server_init
    
    &server 
    pointer_of_proc handle_request
    call http_server_start
end