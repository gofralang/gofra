struct Color
    r char        // Color red value
    g char        // Color green value
    b char        // Color blue value
    a char        // Color alpha value
end


const WHITE    Color = Color { r = -1,  g = -1,  b = -1,  a = -1  }
const BLACK    Color = Color { r = 0,   g = 0,   b = 0,   a = -2  }
const RAYWHITE Color = Color { r = -11, g = -11, b = -11, a = -2  }
const RED      Color = Color { r = -26, g = 41,  b = 55,  a = -2  }
const GREEN    Color = Color { r = 0,   g = -8,  b = 48,  a = -2  }
const BLUE     Color = Color { r = 0,   g = 121, b = -15, a = -2  }
const YELLOW   Color = Color { r = -3,  g = -7,  b = 0,   a = -1  }



enum Key
  W      = 87
  A      = 65
  S      = 83
  D      = 68

  UP     = 265
  DOWN   = 264
  LEFT   = 263
  RIGHT  = 262
  
  SPACE  = 32
  ESCAPE = 256
end