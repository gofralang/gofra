// ==============================================
// HTTP server implementation
// TODO: Add async/thread support
// ==============================================

#include "std/types"
#include "std/os/error"
#include "std/net"
#include "std/memory/static_heap"
#include "std/io"

#include "http/request"
#include "http/response"
#include "http/status"

#ifndef STD_HTTP_SERVER_ALLOCATOR
    // Primitive allocator setup
    #define STD_HTTP_SERVER_ALLOCATOR static_heap_alloc
    #define STD_HTTP_SERVER_DEALLOCATOR drop drop
#endif


const HTTP_DEFAULT_BACKLOG = 128

type HTTPRequestHandler func void _[*HTTPRequest request]
struct HTTPServer
    // HTTP Server instance for HTTP library

    socket *NetSocket // System socket opened for listening

    request HTTPRequest // Internal single-request =0
end


pub func *HTTPServer http_server_new[]
    var server *HTTPServer;
    &server 
        sizeof HTTPServer 
        STD_HTTP_SERVER_ALLOCATOR typecast *HTTPServer 
    !<

    server return
end

pub func void http_server_close[*HTTPServer server]
    server.socket call net_close_socket
    server STD_HTTP_SERVER_DEALLOCATOR
end

pub func void http_server_start[
    *HTTPServer server,
    HTTPRequestHandler handler,
    *string ipv4,
    int port
]
    &server.socket 
        ipv4 port HTTP_DEFAULT_BACKLOG
        call net_ipv4_tcp_listener 
    !<

    server.socket typecast int 0 == if
        "TCP listener failed!" eprint_fatal
    end

    "[http_server] Listening on " print ipv4 print ":" print port print_int "...\n" print

    var request HTTPRequest;
    while true do
        &request.socket server.socket call net_accept_socket !<

        request.socket.fd 0 < if
            "Failed to accept client socket!" eprint_fatal
        end

        "[http_server][request] " print
        request.socket call net_peer_address_string call print
        "\n" print

        &request call _http_server_read_request drop
        &request call handler

        request.socket call net_close_socket 0 < if
            "WARNING: Unable to close client socket!\n" eprint
        end
    end
end

// Check whether the request header block is complete (e.g terminated by an empty line)
func int _http_server_is_request_complete[*HTTPRequest request, int total_read]
    var idx0 int = 0
    var idx1 int = 1
    var idx2 int = 2

    while idx2 total_read < do
        request.io_rx_buffer[idx0] typecast int '\n' == if
            // Empty line (e.g "\n\n")
            request.io_rx_buffer[idx1] typecast int '\n' == if
                1 return
            end

            // Empty line (e.g "\r\n\r\n")
            request.io_rx_buffer[idx1] typecast int '\r' == if
                request.io_rx_buffer[idx2] typecast int '\n' == if
                    1 return
                end
            end
        end

        &idx0 idx0 1 + !<
        &idx1 idx1 1 + !<
        &idx2 idx2 1 + !<
    end

    0 return
end

// Read the request from the client socket.
// The request header block is terminated by an empty line ("\r\n\r\n"), so the socket is
// read until that terminator is found. Reading the request in one shot is not enough:
// a request may be delivered in several TCP segments, and leaving the not-yet-read data
// in the socket makes the kernel reset the connection instead of closing it gracefully.
func int _http_server_read_request[*HTTPRequest request]
    var bytes_read int = 0
    var total_read int = 0

    while total_read HTTP_IO_BUFFER_CAP < do
        &bytes_read
            request.socket
            &request.io_rx_buffer[total_read]
            HTTP_IO_BUFFER_CAP total_read -
        call net_read_socket !<

        bytes_read 0 < if
            "WARNING: Unable to read HTTP request!" eprint
            total_read return
        end

        bytes_read 0 == if
            // Peer has closed the connection
            total_read return
        end

        &total_read total_read bytes_read + !<

        request total_read call _http_server_is_request_complete 0 != if
            total_read return
        end
    end

    total_read return
end
