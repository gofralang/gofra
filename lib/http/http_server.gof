// ==============================================
// HTTP server implementation
// ==============================================

// IO RX/TX buffer capacity expected
#define HTTP_IO_BUFFER_CAP 128

#include "std/types.gof"
#include "std/os/error.gof"

#include "std/net"
#include "std/memory/static_heap.gof"
#include "http/request.gof"
#include "http/response.gof"
#include "http/status.gof"

// TODO: Add async/thread support

// Primitive allocator setup
#ifndef STD_HTTP_SERVER_ALLOCATOR
    #define STD_HTTP_SERVER_ALLOCATOR static_heap_alloc
    #define STD_HTTP_SERVER_DEALLOCATOR drop drop
#endif

const HTTP_DEFAULT_BACKLOG = 128




type HTTPRequestHandler func void _[*HTTPRequest request]
struct HTTPServer
    // HTTP Server instance for HTTP library

    socket *NetSocket // System socket opened for listening


    handler HTTPRequestHandler 
end

pub func *HTTPServer http_server_new[]
    var server *HTTPServer;
    &server 
        sizeof HTTPServer 
        STD_HTTP_SERVER_ALLOCATOR typecast *HTTPServer 
    !<

    server return
end

pub func void http_server_close[*HTTPServer server]
    server.socket call net_close_socket
    server STD_HTTP_SERVER_DEALLOCATOR
end


func void default_handler[*HTTPRequest request]
    request.socket HTTP_STATUS_TEXT_OK "<h1>Hello from Gofra HTTP server!</h1><i>Built with Gofra and native HTTP library</i>";
    call http_send_html_response drop
end


// Bootstrap HTTP server
func void http_server_start[
    *HTTPServer server,
    HTTPRequestHandler handler,
    *string ipv4
    int port
]
    &server.socket 
        ipv4 port HTTP_DEFAULT_BACKLOG
        call net_ipv4_tcp_listener 
    !<

    server.socket typecast int 0 == if 
        "tcp listener failed" eprint_fatal
    end
    
    &server.handler handler !<
    "Listening..." println

    var request HTTPRequest;
    var socket *NetSocket;
    while true do
        &request.socket
            server.socket call net_accept_socket
        !<
        &socket request.socket !<
 
        socket.fd 0 < if
            "Unable to accept to client socket on HTTP server socket\n" eprint_fatal
        end

        "[log_http] Request from: [redacted]" println

        &request call http_server_read_request drop
        &request call default_handler


        request.socket call net_close_socket 0 < if
            "WARNING: Unable to close client socket on HTTP server socket\n" eprint
        end
    end
end



// Read an HTTP request with headers
func int http_server_read_request[*HTTPRequest request]
    var bytes_read int = 0

    &bytes_read
        request.socket
        &request.io_rx_buffer 
        HTTP_IO_BUFFER_CAP
    call net_read_socket !<

    bytes_read 0 < if
        "FATAL: Unable to read HTTP request: " eprint
        bytes_read os_strerror eprint "\n" eprint
        abort
    end

    bytes_read return
end