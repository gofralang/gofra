type _IMatrix *int[][] // Internal

pub func void matrix_transpose[_IMatrix A, _IMatrix B, int M, int N]
    // Transpone matrix A (MxN) into matrix B (NxM)
    // B = A^T
    for i in 0..M do
        for j in 0..N do
            B sizeof int j M * i + * + // B[j][i]
                A sizeof int i N * j + * + ?>  // A[i][j]
            !<
        end
    end
end

pub func void matrix_mul[_IMatrix A, _IMatrix B, _IMatrix C, int M, int N, int K]
    // Matrix multiplication: C = A * B, where A is MxK, B is KxN, and C is MxN
    // C = A · B
    var sum int = 0;

    for i in 0..M do
        for j in 0..N do
            &sum 0 !<
            for k in 0..K do
                &sum 
                    sum 
                    A sizeof int i K * k + * + ?> 
                    B sizeof int k N * j + * + ?> 
                    * + 
                !<
            end
            C sizeof int i N * j + * + sum !<
        end
    end
end



func *int[] matrix_ptr_of[_IMatrix A, int i, int j, int cols]
    // Get pointer to A[i][j] (row-major)
    A sizeof int i cols * j + * + return
end

pub func void matrix_scale[_IMatrix matrix, int rows, int cols, int multiplier]
    // Multiply each element of 2D matrix by scalar
    var v int;


    for row in 0..rows do
    for col in 0..cols do

        &v matrix row col cols matrix_ptr_of ?> !<

        matrix row col cols matrix_ptr_of
        v multiplier * !<
    end end
end

pub func void matrix_vec_mul[_IMatrix W, _IVec x, _IVec y, int M, int N]
    // y = W · x
    // W: M×N, x: N, y: M

    for i in 0..M do
        &y[i]
            W i 0 N matrix_ptr_of
            x
            N call array_dot 
        !<
    end
end

pub func void matrix_vec_linear[_IMatrix W, _IVec x, int N, _IVec b, _IVec y, int M]
    // y = W · x + b
    // W: M×N, x: N, b: M, y: M
    for i in 0..M do
        &y[i]
            W i 0 N matrix_ptr_of 
            x 
            N call array_dot 
            b[i]  + 
        !<
    end
end

pub func void matrix_add_bias[_IMatrix M, _IVec b, int T, int d]
    for i in 0..T do
        for j in 0..d do
            M i j d matrix_ptr_of
                M i j d matrix_ptr_of ?> 
                b[j]
                + 
            !<
        end
    end
end