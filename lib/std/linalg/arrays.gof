type _IVec *int[] // Internal

pub func void array_add[_IVec a, _IVec b, _IVec c, int n]
    for i in 0..n do
        &c[i] a[i] b[i] + !<
    end
end

pub func void array_scale[_IVec a, int s, int n]
    for i in 0..n do
        &a[i] a[i] s * !<
    end
end

pub func int array_sum[_IVec A, int n]
    // Sum each element of integer array and return total sum
    var sum int = 0;

    for i in 0..n do
        &sum sum A[i] + !<
    end

    sum return
end

pub func int array_product[_IVec A, int n]
    // Product each element of integer array and return total product
    var sum int = 1;

    for i in 0..n do
        &sum sum A[i] * !<
    end

    sum return
end

pub func int array_dot[_IVec A, _IVec B, int n]
    // Dot product
    var s int = 0;

    for i in 0..n do
        &s // s = s + a[i] * b[i]
            s 
            A[i] B[i] * 
            + 
        !<
    end

    s return
end

pub func int array_mean[_IVec A, int n]
    A n call array_sum n / return
end

pub func int array_max[_IVec A, int n]
    // Maximum value in array
    var best int;
    var v int;

    &best A[0] !<
    for i in 1..n do
        &v A[i] !<
        v best > if
            &best v !<
        end
    end
    best return
end

pub func int array_min[_IVec A, int n]
    // Minimum value in array
    var best int;
    var v int;

    &best A ?> !<
    for i in 1..n do
        &v A[i] !<
        v best < if
            &best v !<
        end
    end

    best return
end

pub func int array_argmax[_IVec arr, int n]
    // Return index of maximal value in integer array
    var best_idx int = 0;
    var best_val int;
    var v int;
    
    &best_val arr ?> !<
    for i in 1..n do
        &v arr[i] !<
        v best_val > if
            &best_idx i !<
            &best_val v !<
        end
    end
    best_idx return
end

pub func int array_argmin[_IVec arr, int n]
    // Index of minimum value (first occurrence)
    var best_idx int = 0;
    var best_val int;
    var v int;

    &best_val arr ?> !<
    for i in 1..n do
        &v arr[i] !<
        v best_val < if
            &best_idx i !<
            &best_val v !<
        end
    end
    best_idx return
end

pub func int array_linear[_IVec w, _IVec x, int n, int b]
    // y = w · x + b
    w x n array_dot
    b + return
end

pub func int array_var[_IVec A, int n]
    // Variance: Σ(A[i] - mean)² / n
    var mean int;
    &mean A n array_mean !<
    
    var sum int = 0;
    var d int;
    for i in 0..n do
        &d A[i] mean - !<
        &sum sum d d * + !<
    end

    sum n / return
end

pub func void array_fill[_IVec a, int v, int n]
    for i in 0..n do
        &a[i] v !<
    end
end

pub func void array_zero[_IVec a, int n]
    a 0 n array_fill
end

pub func void array_copy[_IVec src, _IVec dst, int n]
    for i in 0..n do
        &dst[i] src[i] !<
    end
end
