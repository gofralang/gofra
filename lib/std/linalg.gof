// ==============================================
// Linear algebra functions for vectors and matrices
// TODO: Generic function with container type holders
// TODO: Vectors as array
// ==============================================

// Internal
type _IVec *int[]
type _IMatrix *int[][]

/// =====
/// Array methods
/// =====


pub func void array_add[_IVec a, _IVec b, _IVec c, int n]
    for i in 0..n do
        &c[i] a[i] b[i] + !<
    end
end

pub func void array_scale[_IVec a, int s, int n]
    for i in 0..n do
        &a[i] a[i] s * !<
    end
end

pub func int array_sum[_IVec A, int n]
    // Sum each element of integer array and return total sum
    var sum int = 0;

    for i in 0..n do
        &sum sum A[i] + !<
    end

    sum return
end

pub func int array_product[_IVec A, int n]
    // Product each element of integer array and return total product
    var sum int = 1;

    for i in 0..n do
        &sum sum A[i] * !<
    end

    sum return
end

pub func int array_dot[_IVec A, _IVec B, int n]
    // Dot product
    var s int = 0;

    for i in 0..n do
        &s // s = s + a[i] * b[i]
            s 
            A[i] B[i] * 
            + 
        !<
    end

    s return
end

pub func int array_mean[_IVec A, int n]
    A n call array_sum n / return
end

pub func int array_max[_IVec A, int n]
    // Maximum value in array
    var best int;
    var v int;

    &best A[0] !<
    for i in 1..n do
        &v A[i] !<
        v best > if
            &best v !<
        end
    end
    best return
end

pub func int array_min[_IVec A, int n]
    // Minimum value in array
    var best int;
    var v int;

    &best A ?> !<
    for i in 1..n do
        &v A[i] !<
        v best < if
            &best v !<
        end
    end

    best return
end

pub func int array_argmax[_IVec arr, int n]
    // Return index of maximal value in integer array
    var best_idx int = 0;
    var best_val int;
    var v int;
    
    &best_val arr ?> !<
    for i in 1..n do
        &v arr[i] !<
        v best_val > if
            &best_idx i !<
            &best_val v !<
        end
    end
    best_idx return
end

pub func int array_argmin[_IVec arr, int n]
    // Index of minimum value (first occurrence)
    var best_idx int = 0;
    var best_val int;
    var v int;

    &best_val arr ?> !<
    for i in 1..n do
        &v arr[i] !<
        v best_val < if
            &best_idx i !<
            &best_val v !<
        end
    end
    best_idx return
end

pub func int array_linear[_IVec w, _IVec x, int n, int b]
    // y = w · x + b
    w x n array_dot
    b + return
end

pub func int array_var[_IVec A, int n]
    // Variance: Σ(A[i] - mean)² / n
    var mean int;
    &mean A n array_mean !<
    
    var sum int = 0;
    var d int;
    for i in 0..n do
        &d A[i] mean - !<
        &sum sum d d * + !<
    end

    sum n / return
end

pub func void array_fill[_IVec a, int v, int n]
    for i in 0..n do
        &a[i] v !<
    end
end

pub func void array_zero[_IVec a, int n]
    a 0 n array_fill
end

pub func void array_copy[_IVec src, _IVec dst, int n]
    for i in 0..n do
        &dst[i] src[i] !<
    end
end

/// =====
/// Matrix methods
/// =====


pub func void matrix_transpose[_IMatrix A, _IMatrix B, int M, int N]
    // Transpone matrix A (MxN) into matrix B (NxM)
    // B = A^T
    for i in 0..M do
        for j in 0..N do
            B sizeof int j M * i + * + // B[j][i]
                A sizeof int i N * j + * + ?>  // A[i][j]
            !<
        end
    end
end

pub func void matrix_mul[_IMatrix A, _IMatrix B, _IMatrix C, int M, int N, int K]
    // Matrix multiplication: C = A * B, where A is MxK, B is KxN, and C is MxN
    // C = A · B
    var sum int = 0;

    for i in 0..M do
        for j in 0..N do
            &sum 0 !<
            for k in 0..K do
                &sum 
                    sum 
                    A sizeof int i K * k + * + ?> 
                    B sizeof int k N * j + * + ?> 
                    * + 
                !<
            end
            C sizeof int i N * j + * + sum !<
        end
    end
end



func *int[] matrix_ptr_of[_IMatrix A, int i, int j, int cols]
    // Get pointer to A[i][j] (row-major)
    A sizeof int i cols * j + * + return
end

pub func void matrix_scale[_IMatrix matrix, int rows, int cols, int multiplier]
    // Multiply each element of 2D matrix by scalar
    var v int;


    for row in 0..rows do
    for col in 0..cols do

        &v matrix row col cols matrix_ptr_of ?> !<

        matrix row col cols matrix_ptr_of
        v multiplier * !<
    end end
end

pub func void matrix_vec_mul[_IMatrix W, _IVec x, _IVec y, int M, int N]
    // y = W · x
    // W: M×N, x: N, y: M

    for i in 0..M do
        &y[i]
            W i 0 N matrix_ptr_of
            x
            N call array_dot 
        !<
    end
end

pub func void matrix_vec_linear[_IMatrix W, _IVec x, int N, _IVec b, _IVec y, int M]
    // y = W · x + b
    // W: M×N, x: N, b: M, y: M
    for i in 0..M do
        &y[i]
            W i 0 N matrix_ptr_of 
            x 
            N call array_dot 
            b[i]  + 
        !<
    end
end

pub func void matrix_add_bias[_IMatrix M, _IVec b, int T, int d]
    for i in 0..T do
        for j in 0..d do
            M i j d matrix_ptr_of
                M i j d matrix_ptr_of ?> 
                b[j]
                + 
            !<
        end
    end
end