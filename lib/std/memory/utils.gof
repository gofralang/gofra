/// General helpers for memory usage

pub func void memset[*int[0] addr, int size, int value]
    // Set memory to int array from given pointer up to + SIZE with given int-value
    for idx in 0..size do
        &addr[idx] value !<
    end
end

pub func *void memcpy[*void dest, *void src, int n]
    dest src n call memcpy_byte_by_byte
end


func *void memcpy_byte_by_byte[*void dest, *void src, int n]
    var d *char;
    var s *char;
    var i int = 0;

    &d dest typecast *char !<
    &s src typecast *char !<

    for i in 0..n do
        d i + 
        s i + ?> 
        !<
    end

    dest return
end