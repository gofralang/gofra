// ==============================================
// Math helpers
// E.g power, min/max, clamp, factorials
// ==============================================

// TODO: Gofra does not have FP so this is only integer-math library

#include "std"

pub func int ipow[int base, int exponent]
    // Integer power (base^exponent) for integer values
    var result int = 1;

    exponent 0 < if 0 return end // TODO: Probably should be error, but for now just return 0

    // TODO: This is not performant way to calculate power, but this is enough for now
    while exponent 0 > do
        &result result base * !<
        &exponent exponent 1 - !<
    end

    result return
end
#define pow ipow // Alias for integer power

pub func int isqrt[int n]
    // Calculate integer square root for an value (e.g floor Babylonian method)
    var y int = 1;
    var x int;

    // TODO: X64/AARCH64 has direct machine ops to perform FSQRT, probably at some time we introduce injected SQRT when done with FPU/FP and need fast SQRT (e.g 3D renderers)
    &x n !< // x = n

    while x y > do 
        &x x y + 2 / !<
        &y n x /     !<
    end

    x return
end
#define sqrt isqrt // Alias for integer square root

pub func int abs[int x]
    // Return absolute value of an negative/positive integer
    x 0 < if
        // TODO: Will be optimized into negation ? 
        x -1 * return // (-n) * -1 => n
    end
    x return // Positive by default
end

pub func int min[int a, int b]
    // Return minimum value from two values
    a b <= if a return end
    b return
end

pub func int max[int a, int b]
    // Return maximal value from two values
    a b >= if a return end
    b return
end

pub func int sign[int x]
    // Return sign of an integer value (-1, 0, 1)
    x 0 < if -1 return end
    x 0 > if 1 return end
    0 return
end

pub func int clamp[int n, int a, int b]
    // Clamp given value between two constraints
    n a < if a return end
    n b > if b return end
    n return
end

pub func int factorial[int n]
    // Factorial (n!) of value
    var r = 1;
    var i = 2;

    while i n <= do
        &r r i * !<
        &i i 1 + !<
    end

    r return
end
