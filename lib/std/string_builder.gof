#include "std/types.gof"
#include "std/memory/utils.gof"
#include "std/memory/static_heap.gof"

// TODO: free

struct StringBuilder
    data CStr
    len int
    cap int
end

#define SB_DEFAULT_CAP 1024
pub func *StringBuilder sb_new[]
    var sb *StringBuilder;
    
    &sb sizeof StringBuilder 
    call static_heap_alloc typecast *StringBuilder !<

    &sb.data SB_DEFAULT_CAP static_heap_alloc typecast CStr !<

    &sb.len 0 !<
    &sb.cap SB_DEFAULT_CAP !<

    sb
end

pub func void sb_append[*StringBuilder sb, *string sv]
        sb.data sb.len +
        sv.data
        sv.len
    call memcpy drop

    &sb.len sb.len sv.len + !<
end

pub func void sb_to_string[*StringBuilder sb, *string sv]
    &sv.data sb.data !<
    &sv.len sb.len !<
end