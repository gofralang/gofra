// ==============================================
// Windows native system interaction layer and constant
// Interacts with kernel via API (WINAPI), acquired from libraries like `kernel32.dll` / `user32.dll` / `ntdll.dll` e.g)
// ==============================================

// TODO: Add AARCH64 Windows layer
// TODO: Check that this layer actually working
// TODO: Add input, network functions as in POSIX
#include "std/types.gof"

// Windows API sometimes requires something name _LP_RESERVED
// This is mostly will be not required by user-end code
#define WINAPI_LP_RESERVED 0

// Line separator
#define OS_LINESEP "\r\n"

// --- Standard Handle Constants ---
#define STD_INPUT_HANDLE   -10
#define STD_OUTPUT_HANDLE  -11
#define STD_ERROR_HANDLE   -12

// --- File Type Constants ---
#define FILE_TYPE_UNKNOWN  0x0000
#define FILE_TYPE_DISK     0x0001
#define FILE_TYPE_CHAR     0x0002   // Character file, typically console or printer
#define FILE_TYPE_PIPE     0x0003

// --- External symbols from kernel libraries (WINAPI) ---
extern func void ExitProcess[int exit_code]
extern func int  GetStdHandle[int std_handle]
extern func bool WriteConsoleA[int console_output_handle,CStr buffer,int chars_to_write,*int chars_written,int reserved]
extern func bool WriteFile[int file_handle,CStr buffer,int bytes_to_write,*int bytes_written,int overlapped]
extern func int  GetFileType[int handle]

// -- Windows API simple wrappers --
pub func void win_exit[int exit_code] exit_code call ExitProcess end
pub func int  win_get_std_handle[int std_handle] std_handle call GetStdHandle end
pub func int  win_get_stdout_handle[] STD_OUTPUT_HANDLE call GetStdHandle end
pub func int  win_get_stderr_handle[] STD_ERROR_HANDLE call GetStdHandle end
pub func int  win_get_stdin_handle[] STD_INPUT_HANDLE call GetStdHandle end
pub func bool win_write_console[int console_output_handle,CStr buffer,int chars_to_write,*int chars_written]
    console_output_handle buffer chars_to_write chars_written WINAPI_LP_RESERVED call WriteConsoleA 
end
pub func bool win_write_file[int file_handle,CStr buffer,int bytes_to_write,*int bytes_written]
    file_handle buffer bytes_to_write bytes_written WINAPI_LP_RESERVED call WriteFile
end
pub func bool win_is_console_handle[int handle]
  handle call GetFileType FILE_TYPE_CHAR ==
end

// Wrapper around Windows write for POSIX
pub func int win_write[int handle, CStr ptr, int len]
    var bytes_written int;

    handle call win_is_console_handle true == if
        // Is an console

        handle call win_get_std_handle
        ptr len
        &bytes_written
        call win_write_console
        0 != if -1 return end
    else
        // Is an file

        handle ptr len
        &bytes_written
        call win_write_file
        0 != if -1 return end
    end

    bytes_written return
end