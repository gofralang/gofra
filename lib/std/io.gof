// TODO: Add proper OR to preprocessor
// TODO: Inline functions has bad debug options and produce improper error messages
// TODO: Test and implement missing features for Windows

#include "std/os/io.gof"

#ifndef __WASM 
    // Open file in read-only mode
    pub func int open_file_fd_ro[*string sv] sv 0 0 call open_file_fd_raw end

    // Read file into SV (string), and return same pointer
    // reads same amount as string view len, returns null ptr (0) on error
    pub func bool read_file_sv[int fd, *string sv]
        fd sv.data sv.len
        call input_fd 0 < return
    end

    // Consume all character bytes from input buffer (e.g `input_fd`)
    // Use as safety method as reading and letting some character leak through 
    pub func void input_exhaust_buffer[]
        var buffer char = '1';

        // TODO: Allow to compare non-integer types (e.g char)
        // TODO: Probably we may break from this loop if read zero bytes, but there is no break construction rn
        while 
            buffer typecast int 
            '\n'
            !=
        do
            STD_IN &buffer 1
            call input_fd drop
        end
    end

    // Input a string from standard console input stream
    // Safe to buffer overflows, as exhaust all remaining IO buffer
    // TODO: Unsafe to big buffers, requires introducing testkit test cases for that
    pub func void input[CStr ptr, int len]
        STD_IN ptr len
        call input_fd drop

        // Safety mechanism:
        // exhaust leftover buffer after system IO read
        call input_exhaust_buffer
    end

#endif // __WASM

// Print an string into standard console output stream
#ifndef __WASM
    pub func void print[*string sv]
        STD_OUT
        sv
        call print_fd drop
    end
#endif
#ifdef __WASM
    pub func void print[*string s]
        STD_OUT
        s
        call print_fd drop
    end
#endif

// Print an string into standard console with trailing newline
pub func void println[*string sv]
    sv call print
    "\n" call print
end


// Print an string into standard console error stream
pub func void eprint[*string sv]
    STD_ERR sv
    print_fd drop
end

// Print an string into standard error console stream and abort execution
// TODO: Probably must refactored into panic system or something like that as this is not I/O responsibility
pub no_return func void eprint_fatal[*string sv]
    "FATAL: " call eprint
    sv call eprint
    #ifndef __WASM
        call abort
    #endif
    #ifdef __WASM
        breakpoint
    #endif
end

// Print given number into given file descriptor / handle
// does not emit '\n' at the end
var print_int64_buf char[20] // Max 64 bit cap
pub func void print_int64_fd[int fd, int num]
    var is_negative bool = 0;
    var idx int = 0; // TOOD: somehow this must be second in stack space must be resolved as relies on general stack space layout allocation and must be fixed ASAP
    var sv string;

    #ifdef __WASM
        &is_negative 0 !<
        &idx 0 !< // TODO: WASM
    #endif
    
    // TODO: This is probably must be merged with `int2str` but must be reviewed, also introduces cross-reference
    num 0 < if
        &num num -1 * !< 
        &is_negative true !<
    end

    num 0 == if
        // Straight zero
        &print_int64_buf[0] '0'  !<

        &sv.data &print_int64_buf !<
        &sv.len 1 !<
        fd &sv
        call print_fd drop

        return
    end

    // Iterates number by single digits via:
    // 1234
    // 1234 % 10 => 4
    // 1234 / 10 = > 123

    while num 0 > do
        &print_int64_buf[idx]
            num 10 % // Get last digit of an number 
            '0' + // real `cast` to char (e.g digit + 48 => char code) 
        !<

        // Shift number from right to left (drop last digit)
        &num num 10 / !< 

        &idx idx 1 + !< // Increment IDX
    end

    is_negative  if
        &print_int64_buf[idx] '-' !<
        &idx idx 1 + !< // Increment IDX
    end

    // Number: 1234
    // After block above buffer will become: [4321]
    // we iterate from right to left so emitting an '1234' string

    &idx idx 1 - !<
    while idx 0 >= do
        // Print current symbol one-by-one from right to left
        &sv.data &print_int64_buf[idx] !<
        &sv.len 1 !<
        fd &sv call print_fd drop

        // Decrement IDX
        &idx idx 1 - !<
    end
    
    // TODO: Possibly would be good to introduce more capable `for` loop e.g:
    // `for i in idx..0`, but this is requires using `idx` as lhs range value which is currently disallowed in for loop range qualifier
end

// Print given number into given file descriptor / handle as hexadecimal 0x
// does not emit '\n' at the end
#ifndef __WASM
    var print_int64_hex_buf char[16] // Max 64 bit cap
    pub func void print_int64_hex_fd[
        int fd, 
        int num, 
        bool show_hex_prefix, 
        bool as_uppercase
    ]
        var idx int = 0;
        var is_negative bool = 0;
        var sv string;

        num 0 < if
            &num num -1 * !< 
            &is_negative true !<
        end

        num 0 == if
            // Straight zero
            show_hex_prefix true == if
                fd "0x0"
                call print_fd drop
                return
            end

            &print_int64_hex_buf[0] '0'  !<

            &sv.data &print_int64_hex_buf !<
            &sv.len 1 !<

            fd &sv
            call print_fd drop
            return
        end

        // For description look in `print_int64_fd`
        while num 0 > do
            var digit int;
            &digit num 16 % !<

            digit 10 < if
                &print_int64_hex_buf[idx] digit '0' + !<
            end
            digit 10 >= if
                as_uppercase if
                    &print_int64_hex_buf[idx] digit 10 - 'A' + !<
                else
                    &print_int64_hex_buf[idx] digit 10 - 'a' + !<
                end
            end

            // Shift number from right to left (drop last digit)
            &num num 16 / !< 

            &idx idx 1 + !< // Increment IDX
        end

        is_negative if
            &print_int64_hex_buf[idx] '-' !<
            &idx idx 1 + !< // Increment IDX
        end

        show_hex_prefix if
            &print_int64_hex_buf[idx] 'x' !<
            &idx idx 1 + !<
            &print_int64_hex_buf[idx] '0' !<
            &idx idx 1 + !<
        end

        // Number: 1234
        // After block above buffer will become: [4321]
        // we iterate from right to left so emitting an '1234' string

        while idx 0 >= do
            // Print current symbol one-by-one from right to left
            &sv.data &print_int64_hex_buf[idx] !<
            &sv.len 1 !<

            fd &sv
            call print_fd drop

            // Decrement IDX
            &idx idx 1 - !<
        end

        // TODO: Possibly would be good to introduce more capable `for` loop e.g:
        // `for i in idx..0`, but this is requires using `idx` as lhs range value which is currently disallowed in for loop range qualifier
    end
#endif

// Print given number into standard console output
pub func void print_int[int number]
    STD_OUT number call print_int64_fd
end

#ifndef __WASM
    // Print given number as hexadecimal into standard console output
    pub func void print_int64_hex[int num]
        STD_OUT num true true call print_int64_hex_fd
    end
#endif

// Print given pointer (TODO: Requires static cast) as hex-addr
#ifndef __WASM
    pub func void print_ptr[*void p]
        p typecast int 
        call print_int64_hex
    end
#endif