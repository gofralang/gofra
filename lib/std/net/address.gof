// Crossplatform network address utility functions
// Works for IPv4

#include "std/char.gof"
#include "std/net/byte_order.gof"
#include "std/os/network.gof"

// Parse IPv4 string (no port spec) into host-network-order integer
// Returns 0 on error
pub func int parse_ipv4_address[*string ipv4]
    var host  int = 0;
    var octet int = 0;
    var shift int = 24;

    var addr_len int;
    &addr_len ipv4.len !<

    for c in 0..addr_len do
        ipv4.data[c] typecast int '.' == if // TODO: remove typecast
            &host octet shift << host | !<
            &octet 0 !<
            &shift shift 8 - !<
        else
            ipv4.data[c] call is_digit lnot if 0 return end

            &octet
                octet 10 * 
                ipv4.data[c] call digit_to_int
                + 
            !<

            octet 255 > if 0 return end // Error
        end
    end

    &host octet shift << host | !<
    host return
end

// Get specified octet by index from parsed IPv4
pub func int ipv4_octet[int ipv4, int idx]
    ipv4
        24 idx 8 * -
    >>
    0xFF & return
end

// Translate parsed host-network-order IPv4 into network socket address
pub func void ipv4_to_sockaddr[*sockaddr_in addr, int ipv4, int port]
    var network_port int;
    var network_host int;

    // Translate host order to network order
    &network_port port call htons !<
    &network_host ipv4 call htonl !<

    &addr.sin_family AF_INET        !<
    &addr.sin_port   network_port   !<
    &addr.sin_addr   network_host   !<
    &addr.sin_zero   0              !<
end

// Get the IPv4 address from a socket address (in host-network-order)
pub func int ipv4_from_sockaddr[*sockaddr_in addr]
    var raw int = 0;

    // sin_addr holds the address in network byte order
    &raw
        addr.sin_addr[0] typecast int
        addr.sin_addr[1] typecast int 8 <<
        |
        addr.sin_addr[2] typecast int 16 <<
        |
        addr.sin_addr[3] typecast int 24 <<
        |
    !<

    raw call ntohl return
end

// Get the TCP port from a socket address (in host-network-order)
pub func int port_from_sockaddr[*sockaddr_in addr]
    var raw int = 0;

    // sin_port holds the port in network byte order
    &raw
        addr.sin_port[0] typecast int
        addr.sin_port[1] typecast int 8 <<
        |
    !<

    raw call ntohs return
end

// Check is parsed host-network-order IPv4 is loopback
pub func bool ipv4_is_loopback[int addr]
    addr 0 call ipv4_octet 
    127 == return
end
